<Window x:Class="ProtectEyes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:ProtectEyes.ViewModels"
        Title="Protect Eyes" Height="530" Width="600"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" 
                    PrimaryColor="Teal" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SettingsCardLabelTextBlock" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody1TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <materialDesign:DialogHost>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TabControl Grid.Row="0" 
                        Style="{StaticResource MaterialDesignTabControl}"
                        Margin="12">
                
                <!-- 配置选项卡 -->
                <TabItem Header="{Binding ConfigTabHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" Orientation="Vertical">
                            
                            <!-- 时间间隔设置 -->
                            <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DurationDesc}" 
                                               Style="{StaticResource SettingsCardLabelTextBlock}"/>
                                    <Slider Value="{Binding Duration}" 
                                            Maximum="600" Minimum="1"
                                            materialDesign:HintAssist.Hint="{Binding MinutesHint}"/>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <!-- 通知显示时间设置 -->
                            <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayNotifySecondsDesc}" 
                                               Style="{StaticResource SettingsCardLabelTextBlock}"/>
                                    <Slider Value="{Binding DisplayNotifySeconds}" 
                                            Maximum="120" Minimum="1"
                                            materialDesign:HintAssist.Hint="{Binding SecondsHint}"/>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <!-- 选项设置 -->
                            <materialDesign:Card Padding="14,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ShouldContinue}" 
                                              Content="{Binding AllowExecutionText}"/>
                                    <CheckBox IsChecked="{Binding AutoStart}" 
                                              Content="{Binding AutoStartText}"
                                              Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding LanguageText}"
                                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                                               FontFamily="Microsoft YaHei UI, Segoe UI"
                                               Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Mode"
                                              SelectedValue="{Binding LanguageMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <!-- 按钮区域 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding SaveConfigText}" 
                                        Command="{Binding SaveConfigCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding SimulateNotifyText}" 
                                    Command="{Binding SimulateNotifyCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,8,0"/>
                                <Button Content="{Binding ExitText}" 
                                        Click="Button_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <!-- 关于选项卡 -->
                <TabItem Header="{Binding AboutTabHeader}">
                    <materialDesign:Card Padding="24" Margin="16">
                        <StackPanel>
                            <TextBlock Text="Protect Eyes" 
                                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock Style="{StaticResource MaterialDesignBody1TextBlock}">
                                <Run Text="{Binding GitHubLabel, Mode=OneWay}"/>
                                <Hyperlink NavigateUri="https://github.com/qiuhaotc/ProtectEyes" 
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    https://github.com/qiuhaotc/ProtectEyes
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding LastModifiedText}" 
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </TabItem>
                
            </TabControl>
            
            <!-- 状态栏 -->
            <StatusBar Grid.Row="1">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusDesc}" 
                               Style="{StaticResource MaterialDesignBody2TextBlock}"/>
                </StatusBarItem>
            </StatusBar>
            
        </Grid>
    </materialDesign:DialogHost>
</Window>
